#!/usr/bin/env bash
# Optional early indicator, never a commit blocker. Run ./bless.sh --staged
# directly for an exit code; CI can run ./bless.sh --all when configured.
set -uo pipefail

repo_root="$(git rev-parse --show-toplevel)"

if "${repo_root}/bless.sh" --staged; then
	exit 0
fi

{
	printf '\n'
	printf 'pre-commit: the checks above reported findings. The commit still\n'
	printf '  went through - this hook only reports. Fix them before publishing.\n\n'
} >&2
exit 0
